# Arquivos pessoais do usuario — NUNCA sobem pro repo publico
# Usa /pasta/* em vez de /pasta/ pra permitir re-incluir subpastas com !
/bases/*

# Excecao: manter os templates vazios pra quem clona
!/bases/_template/

# Credenciais e env (mas .env.example pode ser commitado como template)
.env
.env.*
!.env.example
*.secrets
*.pem
*.key
client_secret_*.json
.secrets/

# Arquivos locais de trabalho
*.local.md
*.draft.md
*.scratch.*

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.cursor/

# Python (notebooklm-py etc)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node (vibe coding)
node_modules/
.next/
dist/
build/

# Logs
*.log
npm-debug.log*
.sync-hub-last

# Sessões exportadas
/log/*.json
/log/*.jsonc

# Senhas e dados sensíveis
NP.md

# Plugins WordPress extraídos (código terceiro com chaves hardcoded)
/Extraido 700/

# Ferramentas locais (dashboards, etc)
/tools/*

# Pastas pessoais do usuario — squads, projetos, dados de cliente
/squads/*
/projetos/*
!/projetos/_template/

# Chaves e configuracoes locais
authelia-login-llm-keys-digest.txt
litellm-config.yaml
opencode.server.json
projetos/Chaves LLM.md

# Scripts de deploy com credenciais
scripts/*authelia*

# Dados de cliente (calls, checkins, docs)
/docs/calls/
/docs/checkins/

# Config do editor local
/.obsidian/

# Arquivos locais de trabalho (nao skills)
/_archive/
/reports/
/Dockploy.md
*.zip
/articles_output.py
/artigos-*.json

