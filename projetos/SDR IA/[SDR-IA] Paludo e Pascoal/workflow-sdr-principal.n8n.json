    {
      "parameters": {
        "jsCode": "const rawOutput = $input.first().json.output || '';\nlet aiData = {};\n\ntry {\n  const startIndex = rawOutput.indexOf('{');\n  const endIndex = rawOutput.lastIndexOf('}');\n  if (startIndex !== -1 && endIndex !== -1) {\n    const jsonString = rawOutput.substring(startIndex, endIndex + 1);\n    aiData = JSON.parse(jsonString);\n  } else {\n    throw new Error('JSON nao encontrado');\n  }\n} catch (error) {\n  aiData = { is_mql: false, motivo: 'Erro tecnico na leitura da QA' };\n}\n\nreturn [{\n  json: {\n    is_mql: aiData.is_mql === true,\n    motivo: aiData.motivo || 'Nao especificado',\n    motivo_tag: aiData.motivo_tag || 'AguardandoResposta',\n    resumo_lead: aiData.resumo_lead || {}\n  }\n}];"
      },
      "id": "node-parse-qa",
      "name": "Parse JSON QA",
      "type": "n8n-nodes-base.code",
