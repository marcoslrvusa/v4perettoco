    {
      "parameters": {
        "jsCode": "const HOURS_LIMIT = 72;\nconst historyItems = $input.all();\nlet formattedHistory = '';\nconst now = new Date();\nconst cutoffTime = new Date(now.getTime() - (HOURS_LIMIT * 60 * 60 * 1000));\n\nif (historyItems.length > 0) {\n  historyItems.sort((a, b) => new Date(a.json.created_at) - new Date(b.json.created_at));\n\n  for (const item of historyItems) {\n    const msgDateStr = item.json.created_at || item.json.timestamp;\n    if (msgDateStr) {\n      const msgDate = new Date(msgDateStr);\n      if (msgDate > cutoffTime) {\n        const role = item.json.role === 'human' ? 'Cliente' : 'Matheus';\n        const cleanContent = (item.json.content || '').replace(/\\n/g, ' ');\n        formattedHistory += role + ': ' + cleanContent + '\\n';\n      }\n    }\n  }\n}\nreturn [{ json: { formattedHistory } }];"
      },
      "id": "node-format-history",
      "name": "Formatar Historico",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
